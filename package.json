{
  "name": "bwb-browser",
  "version": "4.1.0",
  "description": "Browser Without Bloat \u2014 lightweight MCP server that gives AI agents browser superpowers. Static-first fetch ladder (Chromium only when JS demands it), lean profiles for Termux/1GB VPS, resource vigilance, tab journaling. Runs anywhere. Stays lean like air.",
  "bin": {
    "bwb": "bin/bwb"
  },
  "files": [
    "server.mjs",
    "lib/",
    "bin/bwb",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "for f in server.mjs lib/*.mjs; do node --check \"$f\" || exit 1; done",
    "smoke": "node test/smoke.mjs",
    "test:browser": "node --test test/integration.mjs",
    "test:all": "npm run lint && npm test && npm run verify:docs && npm run smoke && npm run test:browser",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "cdp",
    "chrome-devtools-protocol",
    "headless",
    "bwb",
    "browser-without-bloat",
    "ai-agent",
    "termux",
    "android",
    "natural-language",
    "llm",
    "ai-tools",
    "claude",
    "opencode",
    "agent",
    "web-scraping",
    "browser-testing",
    "e2e-testing",
    "fingerprint",
    "session",
    "lightweight",
    "low-dependency",
    "mobile",
    "devtools"
  ],
  "author": "Krish Tiwari (@krshforever)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krshforever/bwb-browser.git"
  },
  "bugs": {
    "url": "https://github.com/krshforever/bwb-browser/issues"
  },
  "homepage": "https://github.com/krshforever/bwb-browser#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "chrome-remote-interface": "^0.34.0",
    "linkedom": "^0.18.13",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
