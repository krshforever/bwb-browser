{
  "name": "bwb-browser",
  "version": "3.2.0",
  "description": "Browser Without Bloat — 76KB MCP server that gives AI agents browser superpowers. Natural language interaction, live event watching, persistent sessions, multi-tab. Runs on Termux/Android, desktop, and CI. Zero heavy dependencies.",
  "bin": {
    "bwb": "bin/bwb"
  },
  "files": [
    "server.mjs",
    "lib/",
    "bin/bwb",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --check server.mjs && node --check lib/*.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "cdp",
    "chrome-devtools-protocol",
    "headless",
    "bwb",
    "browser-without-bloat",
    "ai-agent",
    "termux",
    "android",
    "natural-language",
    "llm",
    "ai-tools",
    "claude",
    "opencode",
    "agent",
    "web-scraping",
    "browser-testing",
    "e2e-testing",
    "fingerprint",
    "session",
    "lightweight",
    "zero-dependencies",
    "mobile",
    "devtools"
  ],
  "author": "Krish Tiwari (@krshforever)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krshforever/bwb-browser.git"
  },
  "bugs": {
    "url": "https://github.com/krshforever/bwb-browser/issues"
  },
  "homepage": "https://github.com/krshforever/bwb-browser#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-remote-interface": "^0.34.0",
    "zod": "^3.22.0"
  }
}
