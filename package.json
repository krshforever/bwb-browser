    "headless",
    "bwb",
    "browser-without-bloat"
  ],
  "author": "krsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krshforever/bwb-browser-termux.git"
  },
  "bugs": {
    "url": "https://github.com/krshforever/bwb-browser-termux/issues"
  },
  "homepage": "https://github.com/krshforever/bwb-browser-termux#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-remote-interface": "^0.34.0",
    "zod": "^3.22.0"
